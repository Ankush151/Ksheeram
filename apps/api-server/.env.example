# ==============================================================================
# KSHEERAAM API SERVER ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Replica Set Connection String
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ksheeraam_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ksheeraam_db

# JWT Authentication (Keep secret, change in production)
JWT_SECRET=ksheeraam_super_secure_jwt_secret_dev_key_2026!
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Official Meta WhatsApp Cloud API Credentials
WHATSAPP_VERIFY_TOKEN=ksheeraam_wa_verify_token_secure_2026
WHATSAPP_API_TOKEN=mock_meta_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=10892049812903

# Payment Gateway Webhook HMAC Secret (e.g., Razorpay)
WEBHOOK_SECRET=ksheeraam_webhook_secret_hmac_sha256

# Business Rules
ORDER_CUTOFF_TIME=20:00
MIN_WALLET_BALANCE_PAISE=15000
